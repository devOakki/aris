# ==============================================================================
# ARIS Platform - Production .gitignore
# Only track source code and required project assets. Exclude all binaries,
# environment variables, build artifacts, virtual environments, and caches.
# ==============================================================================

# ─── Documentation Assets & Non-Code Media ────────────────────────────────────
docs/*.pdf
docs/*.pptx
docs/*.ppt
docs/*.docx
docs/*.doc
docs/*.xlsx
docs/*.xls
docs/*.csv
docs/*.html
docs/*.htm
docs/*.jpeg
docs/*.jpg
docs/*.png
docs/*.webp
docs/*.gif
docs/*.svg
docs/*.bmp
docs/*.tiff
docs/*.zip
docs/*.rar
docs/*.tar.gz
docs/*.7z
docs/*.mp4
docs/*.mov
docs/*.avi

# ─── Python & Django (Server) ─────────────────────────────────────────────────
**/venv/
**/.venv/
**/env/
**/ENV/
**/__pycache__/
*.py[cod]
*$py.class
*.so
*.egg
*.egg-info/
dist/
build/
eggs/
.eggs/
*.sqlite3
*.sqlite3-journal
**/db.sqlite3
**/db.sqlite3-journal
**/media/
**/staticfiles/
.pytest_cache/
**/.pytest_cache/
.coverage
**/.coverage*
htmlcov/
**/.mypy_cache/
**/.ruff_cache/
pip-wheel-metadata/

# ─── Next.js & Node.js (Client) ───────────────────────────────────────────────
**/node_modules/
**/.next/
**/out/
**/build/
**/dist/
**/.turbo/
**/.vercel/
*.tsbuildinfo
.npm/
.pnpm-store/
.yarn/
package-lock.json.bak

# ─── Environment Variables & Secrets ──────────────────────────────────────────
.env
.env.*
**/.env
**/.env.*
!**/.env.example
*.pem
*.key
*.cert
*.crt

# ─── Logs, Debugging & Temporary Files ────────────────────────────────────────
*.log
*.log.*
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*
scratch/
tmp/
temp/
*.tmp
*.bak
*~

