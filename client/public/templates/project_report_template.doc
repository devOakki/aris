<style>
@page Section1 {
  size: 8.5in 11.0in;
  margin: 1.0in 1.0in 1.0in 1.5in;
  mso-header-margin: 0.5in;
  mso-footer-margin: 0.5in;
}
div.Section1 { page: Section1; }
body {
  font-family: 'Times New Roman', Times, serif;
  font-size: 12pt;
  line-height: 1.5;
  color: #111827;
}
h1 { font-size: 16pt; font-weight: bold; text-align: center; margin-top: 24pt; margin-bottom: 12pt; text-transform: uppercase; }
h2 { font-size: 14pt; font-weight: bold; margin-top: 18pt; margin-bottom: 8pt; border-bottom: 1px solid #ccc; padding-bottom: 4pt; }
h3 { font-size: 12pt; font-weight: bold; margin-top: 12pt; margin-bottom: 4pt; }
p { margin-bottom: 8pt; text-align: justify; }
ul, ol { margin-top: 0; margin-bottom: 8pt; padding-left: 24pt; }
li { margin-bottom: 4pt; }
.univ-header { text-align: center; margin-top: 30pt; }
.univ-name { font-size: 18pt; font-weight: bold; color: #B81D24; }
.dept-name { font-size: 13pt; font-weight: bold; margin-top: 4pt; }
.report-title { font-size: 16pt; font-weight: bold; margin: 30pt 0 10pt 0; text-transform: uppercase; color: #1e3a8a; }
.sign-table { width: 100%; border-collapse: collapse; margin-top: 60pt; }
.sign-table td { width: 50%; vertical-align: bottom; font-size: 11pt; padding: 10pt; }
.guideline-alert { background: #fef2f2; border: 1px solid #fecaca; border-left: 4px solid #B81D24; padding: 10pt; margin: 12pt 0; font-size: 10pt; color: #991b1b; }
</style>
</head>
<body>
<div class="Section1">
  <!-- TITLE PAGE -->
  <div class="univ-header">
    <div class="univ-name">DEV BHOOMI UTTARAKHAND UNIVERSITY</div>
    <div class="dept-name">School of Computer Applications</div>
    <br/><br/>
    <p style="font-size: 12pt; font-weight: bold;">A MINOR PROJECT REPORT ON</p>
